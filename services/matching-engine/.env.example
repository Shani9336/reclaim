# FoundIt Matching Engine — Environment Variables
# Copy to .env and fill in values

# Server settings
PORT=8000
ENVIRONMENT=development   # development | production

# Auth (must match MATCHING_SERVICE_API_KEY in Next.js .env.local)
API_KEY=dev-secret-key

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Model selection (default: all-MiniLM-L6-v2 — fast CPU-friendly)
# Options:
#   sentence-transformers/all-MiniLM-L6-v2     (384 dim, ~80ms CPU)  ← MVP
#   sentence-transformers/all-mpnet-base-v2     (768 dim, ~200ms CPU) ← higher accuracy
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
