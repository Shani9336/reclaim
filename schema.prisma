// ReClaim — Prisma Schema
// Database: PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  USER
  FINDER
  ADMIN
  SUPER_ADMIN
}

enum ItemType {
  LOST
  FOUND
}

enum Category {
  ELECTRONICS
  DOCUMENTS
  WALLET
  KEYS
  BAGS
  JEWELRY
  CLOTHING
  OTHER
}

enum ItemStatus {
  OPEN
  CLAIMED
  VERIFIED
  RETURNED
  CLOSED
}

enum ItemVisibility {
  PUBLIC
  PRIVATE
}

enum MatchStatus {
  PENDING
  REVIEWED
  CONFIRMED
  REJECTED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  MATCH_FOUND
  CLAIM_SUBMITTED
  CLAIM_APPROVED
  CLAIM_REJECTED
  ITEM_RETURNED
  NEW_ITEM_NEARBY
  SYSTEM
}

enum SpaceType {
  CAMPUS
  MALL
  AIRPORT
  METRO
  RAILWAY
  HOSPITAL
  PARK
  OTHER
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  DUPLICATE
  FAKE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
}

// ============================================================
// MODELS
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed; null for OAuth users
  role          Role      @default(USER)
  phone         String?
  showEmail     Boolean   @default(false)
  showPhone     Boolean   @default(false)
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  items         Item[]          @relation("UserItems")
  claims        Claim[]         @relation("UserClaims")
  notifications Notification[]
  reports       Report[]        @relation("UserReports")
  savedSearches SavedSearch[]
  adminOfSpaces Space[]         @relation("SpaceAdmin")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Space {
  id          String    @id @default(cuid())
  name        String
  type        SpaceType @default(OTHER)
  description String?
  address     String
  city        String
  state       String?
  country     String    @default("India")
  lat         Float?
  lng         Float?
  logoUrl     String?
  website     String?
  adminId     String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  admin       User      @relation("SpaceAdmin", fields: [adminId], references: [id])
  items       Item[]

  @@map("spaces")
}

model Item {
  id                   String         @id @default(cuid())
  type                 ItemType
  title                String
  description          String         @db.Text
  category             Category
  color                String?
  brand                String?
  images               String[]       // Cloudinary URLs
  tags                 String[]       // auto-generated + manual
  reward               String?        // e.g. "₹500 reward"
  status               ItemStatus     @default(OPEN)
  visibility           ItemVisibility @default(PUBLIC)

  // Location
  locationText         String?
  locationLat          Float?
  locationLng          Float?

  // Lost-specific
  dateLost             DateTime?
  timeLost             String?
  distinctiveFeatures  String?        @db.Text

  // Found-specific
  dateFound            DateTime?
  storageLocation      String?
  handoverInstructions String?        @db.Text

  // Relations
  userId               String
  spaceId              String?
  user                 User           @relation("UserItems", fields: [userId], references: [id], onDelete: Cascade)
  space                Space?         @relation(fields: [spaceId], references: [id])

  lostMatches          Match[]        @relation("LostItemMatches")
  foundMatches         Match[]        @relation("FoundItemMatches")
  claims               Claim[]
  reports              Report[]

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([type, status, category])
  @@index([userId])
  @@index([spaceId])
  @@index([createdAt])
  @@map("items")
}

model Match {
  id              String      @id @default(cuid())
  lostItemId      String
  foundItemId     String
  score           Float       // 0.0 to 1.0
  reasoning       Json        // { text, category, color, date }
  status          MatchStatus @default(PENDING)
  notifiedAt      DateTime?
  adminReviewedAt DateTime?
  adminNote       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lostItem  Item @relation("LostItemMatches", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem Item @relation("FoundItemMatches", fields: [foundItemId], references: [id], onDelete: Cascade)

  @@unique([lostItemId, foundItemId])
  @@index([score])
  @@map("matches")
}

model Claim {
  id          String      @id @default(cuid())
  itemId      String
  claimantId  String
  description String      @db.Text
  proofImages String[]
  proofText   String?     @db.Text
  status      ClaimStatus @default(PENDING)
  adminNote   String?
  adminId     String?
  reviewedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  item     Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimant User @relation("UserClaims", fields: [claimantId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([claimantId])
  @@map("claims")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  emailSent Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model Report {
  id         String       @id @default(cuid())
  itemId     String
  reporterId String
  reason     ReportReason
  details    String?      @db.Text
  status     ReportStatus @default(OPEN)
  adminNote  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  item     Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reporter User @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model SavedSearch {
  id        String    @id @default(cuid())
  userId    String
  name      String
  filters   Json
  lastRanAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_searches")
}
